<section style="background-color:#0a0a0a;min-height:100vh;padding:4rem 0 5rem;">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">

    <!-- Header -->
    <div style="text-align:center;margin-bottom:3.5rem;">
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:1.25rem;">
        <div style="height:1px;width:40px;background:#C9A84C;"></div>
        <span style="font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.25em;text-transform:uppercase;color:#C9A84C;">Help</span>
        <div style="height:1px;width:40px;background:#C9A84C;"></div>
      </div>
      <h1 style="margin:0;font-family:'Arial Black',Arial,sans-serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:-0.02em;">Frequently Asked Questions</h1>
    </div>

    <!-- FAQ grid -->
    <div style="display:grid;grid-template-columns:1fr;gap:1rem;max-width:900px;margin:0 auto;" id="faq-grid">

      <!-- Q1 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">How long does shipping take?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">Standard delivery takes 5&ndash;7 working days. Express delivery takes 2&ndash;3 working days. Overnight delivery is available for next-day arrival. Standard shipping is free on all orders over &euro;150.</p>
      </div>

      <!-- Q2 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">How do I return an item?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">We offer a 14-day return window from the date of delivery. Email us at <a href="mailto:returns@the00sversion.com" style="color:#C9A84C;text-decoration:none;">returns@the00sversion.com</a> with your order number to get started. Returns within the EU are completely free.</p>
      </div>

      <!-- Q3 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">What sizes do you stock?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">Most items are available in XS through XXL. Our cargo pants are stocked in waist sizes 28 to 36. Check our <a href="/pages/size-guide" style="color:#C9A84C;text-decoration:none;">Size Guide</a> for full measurements and fit advice.</p>
      </div>

      <!-- Q4 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">Do you ship across the EU?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">Yes, we ship to all EU countries. Orders over &euro;150 qualify for free standard shipping across the European Union.</p>
      </div>

      <!-- Q5 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">How do I use a discount code?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">Discount codes are applied at checkout. Once you&rsquo;re on the checkout page, look for the &ldquo;Discount code&rdquo; field, enter your code and click Apply before completing your purchase.</p>
      </div>

      <!-- Q6 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">Are your clothes pre-shrunk?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">Yes. All of our garments are pre-washed and pre-shrunk before being packaged, so the size you order is the size you get &mdash; wash after wash.</p>
      </div>

      <!-- Q7 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">When will sold out items be back in stock?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">Follow <a href="https://www.tiktok.com/@the00sversion" target="_blank" rel="noopener noreferrer" style="color:#C9A84C;text-decoration:none;">@the00sversion</a> on TikTok for all restock announcements and new drop reveals. Restocks are announced there first.</p>
      </div>

      <!-- Q8 -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;transition:border-color 0.2s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.2)'" onmouseout="this.style.borderColor='#1a1a1a'">
        <p style="margin:0 0 0.6rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;color:#C9A84C;line-height:1.4;">What payment methods do you accept?</p>
        <p style="margin:0;font-family:Arial,sans-serif;font-size:0.875rem;color:#a3a3a3;line-height:1.7;">We accept all major credit and debit cards, Apple Pay, and Google Pay. All payments are processed securely through Shopify&rsquo;s checkout.</p>
      </div>

    </div>

    <!-- Still need help? -->
    <div style="margin-top:3rem;max-width:900px;margin-left:auto;margin-right:auto;text-align:center;background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:2.5rem 2rem;">
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:1rem;">
        <div style="height:1px;width:32px;background:#C9A84C33;"></div>
        <span style="font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#525252;">Still need help?</span>
        <div style="height:1px;width:32px;background:#C9A84C33;"></div>
      </div>
      <p style="margin:0 0 0.5rem;font-family:'Arial Black',Arial,sans-serif;font-size:1.1rem;font-weight:900;color:#e5e5e5;text-transform:uppercase;">Get in touch</p>
      <p style="margin:0 0 1.5rem;font-family:Arial,sans-serif;font-size:0.875rem;color:#737373;line-height:1.6;">Our team typically responds within 24 hours.</p>
      <a href="mailto:support@the00sversion.com" class="btn-gold" style="text-decoration:none;">support@the00sversion.com</a>
    </div>

  </div>
</section>

<style>
  @media(min-width:768px){ #faq-grid { grid-template-columns: repeat(2,1fr) !important; } }
</style>

{% schema %}
{
  "name": "Page FAQ",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
