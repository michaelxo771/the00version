<section
  id="tiktok-banner"
  style="
    background-color: #0a0a0a;
    border-top: 1px solid #1a1a1a;
    padding: 80px 0;
  "
>
  <div style="max-width: 800px; margin: 0 auto; padding: 0 1.5rem; text-align: center;">

    <!-- Eyebrow -->
    <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 1.25rem;">
      <div style="height: 1px; width: 32px; background-color: #C9A84C;"></div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="#C9A84C" aria-hidden="true">
        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
      </svg>
      <div style="height: 1px; width: 32px; background-color: #C9A84C;"></div>
    </div>

    <!-- Headline -->
    <h2
      style="
        margin: 0 0 1rem;
        font-family: 'Arial Black', Arial, sans-serif;
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        color: #e5e5e5;
        line-height: 1;
      "
    >
      <span style="color: #C9A84C;">500,000</span> Likes<br>And Growing
    </h2>

    <!-- Subtext -->
    <p
      style="
        margin: 0 auto 2.5rem;
        max-width: 480px;
        font-family: Arial, sans-serif;
        font-size: 0.9375rem;
        color: #737373;
        line-height: 1.7;
      "
    >Join the community. New drops, behind the scenes, and era content.</p>

    <!-- CTA button -->
    <a
      href="https://www.tiktok.com/@the00sversion"
      target="_blank"
      rel="noopener noreferrer"
      style="
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #C9A84C;
        color: #0a0a0a;
        font-family: 'Arial Black', Arial, sans-serif;
        font-size: 0.8rem;
        font-weight: 900;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 1rem 2rem;
        border-radius: 3px;
        transition: opacity 0.2s ease;
      "
      onmouseenter="this.style.opacity='0.85'"
      onmouseleave="this.style.opacity='1'"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
      </svg>
      Follow @the00sversion on TikTok
    </a>

  </div>
</section>

{% schema %}
{
  "name": "TikTok Banner",
  "limit": 1,
  "settings": [],
  "presets": [{ "name": "TikTok Banner" }]
}
{% endschema %}
