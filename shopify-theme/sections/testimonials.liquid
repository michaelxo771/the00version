<section
  id="testimonials"
  style="
    background-color: #0a0a0a;
    padding: 80px 0;
  "
>
  <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;">

    <!-- Header -->
    <div style="text-align: center; margin-bottom: 3rem;">
      <p
        style="
          margin: 0 0 0.5rem;
          font-family: Arial, sans-serif;
          font-size: 11px;
          font-weight: 900;
          letter-spacing: 0.3em;
          text-transform: uppercase;
          color: #C9A84C;
        "
      >Reviews</p>
      <h2
        style="
          margin: 0;
          font-family: 'Arial Black', Arial, sans-serif;
          font-size: clamp(1.75rem, 4vw, 2.5rem);
          font-weight: 900;
          text-transform: uppercase;
          color: #e5e5e5;
          letter-spacing: -0.01em;
        "
      >What They&rsquo;re Saying</h2>
    </div>

    <!-- Reviews grid -->
    <div
      style="
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
      "
      class="testimonials-grid"
    >

      <!-- Review 1: Dani R. — New York Era Cap -->
      <article
        style="
          background-color: #0d0d0d;
          border: 1px solid #1a1a1a;
          border-radius: 2px;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 16px;
          transition: border-color 0.2s ease;
        "
        onmouseenter="this.style.borderColor='rgba(201,168,76,0.20)'"
        onmouseleave="this.style.borderColor='#1a1a1a'"
      >
        <!-- Stars -->
        <div style="display: flex; gap: 4px;">
          {%- for i in (1..5) -%}
            <svg width="16" height="16" viewBox="0 0 20 20" fill="#C9A84C" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {%- endfor -%}
        </div>

        <!-- Review text -->
        <p
          style="
            margin: 0;
            font-family: Arial, sans-serif;
            font-size: 0.875rem;
            line-height: 1.7;
            color: #a3a3a3;
            flex: 1;
          "
        >&ldquo;Ordered the Block Hoodie Set and it&rsquo;s a different level. Heavyweight fabric, clean embroidery, fits exactly how it should. Wore it out and got compliments straight away.&rdquo;</p>

        <!-- Gold divider -->
        <div style="height: 1px; background: linear-gradient(to right, rgba(201,168,76,0.3), transparent);"></div>

        <!-- Reviewer -->
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <p style="margin: 0; font-family: 'Arial Black', Arial, sans-serif; font-size: 0.875rem; font-weight: 900; color: #e5e5e5;">Tyler M.</p>
              <span
                style="
                  font-family: Arial, sans-serif;
                  font-size: 0.625rem;
                  font-weight: 700;
                  letter-spacing: 0.05em;
                  text-transform: uppercase;
                  color: #4ade80;
                "
              >&#10003; Verified</span>
            </div>
            <p style="margin: 0; font-family: Arial, sans-serif; font-size: 0.6875rem; color: #525252;">London, UK</p>
          </div>
          <p style="margin: 0; font-family: Arial, sans-serif; font-size: 0.6875rem; color: #404040; text-align: right; line-height: 1.4;">Block Hoodie Set</p>
        </div>
      </article>

      <!-- Review 2: Marcus O. — Victory 00 Set -->
      <article
        style="
          background-color: #0d0d0d;
          border: 1px solid #1a1a1a;
          border-radius: 2px;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 16px;
          transition: border-color 0.2s ease;
        "
        onmouseenter="this.style.borderColor='rgba(201,168,76,0.20)'"
        onmouseleave="this.style.borderColor='#1a1a1a'"
      >
        <!-- Stars -->
        <div style="display: flex; gap: 4px;">
          {%- for i in (1..5) -%}
            <svg width="16" height="16" viewBox="0 0 20 20" fill="#C9A84C" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {%- endfor -%}
        </div>

        <!-- Review text -->
        <p
          style="
            margin: 0;
            font-family: Arial, sans-serif;
            font-size: 0.875rem;
            line-height: 1.7;
            color: #a3a3a3;
            flex: 1;
          "
        >&ldquo;The Boston 23 Tee is clean as anything. The graphic is sharp, doesn&rsquo;t feel cheap at all. Exactly the early 2000s energy I was looking for.&rdquo;</p>

        <!-- Gold divider -->
        <div style="height: 1px; background: linear-gradient(to right, rgba(201,168,76,0.3), transparent);"></div>

        <!-- Reviewer -->
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <p style="margin: 0; font-family: 'Arial Black', Arial, sans-serif; font-size: 0.875rem; font-weight: 900; color: #e5e5e5;">Ash P.</p>
              <span
                style="
                  font-family: Arial, sans-serif;
                  font-size: 0.625rem;
                  font-weight: 700;
                  letter-spacing: 0.05em;
                  text-transform: uppercase;
                  color: #4ade80;
                "
              >&#10003; Verified</span>
            </div>
            <p style="margin: 0; font-family: Arial, sans-serif; font-size: 0.6875rem; color: #525252;">Manchester, UK</p>
          </div>
          <p style="margin: 0; font-family: Arial, sans-serif; font-size: 0.6875rem; color: #404040; text-align: right; line-height: 1.4;">Boston 23 Tee</p>
        </div>
      </article>

      <!-- Review 3: Jade C. — Boston 23 Sports Tee -->
      <article
        style="
          background-color: #0d0d0d;
          border: 1px solid #1a1a1a;
          border-radius: 2px;
          padding: 24px;
          display: flex;
          flex-direction: column;
          gap: 16px;
          transition: border-color 0.2s ease;
        "
        onmouseenter="this.style.borderColor='rgba(201,168,76,0.20)'"
        onmouseleave="this.style.borderColor='#1a1a1a'"
      >
        <!-- Stars -->
        <div style="display: flex; gap: 4px;">
          {%- for i in (1..5) -%}
            <svg width="16" height="16" viewBox="0 0 20 20" fill="#C9A84C" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {%- endfor -%}
        </div>

        <!-- Review text -->
        <p
          style="
            margin: 0;
            font-family: Arial, sans-serif;
            font-size: 0.875rem;
            line-height: 1.7;
            color: #a3a3a3;
            flex: 1;
          "
        >&ldquo;Got the Chi-Town 23 Flares and they&rsquo;re serious. The fit is wide but structured, not sloppy. This brand actually gets the era.&rdquo;</p>

        <!-- Gold divider -->
        <div style="height: 1px; background: linear-gradient(to right, rgba(201,168,76,0.3), transparent);"></div>

        <!-- Reviewer -->
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <p style="margin: 0; font-family: 'Arial Black', Arial, sans-serif; font-size: 0.875rem; font-weight: 900; color: #e5e5e5;">Jordan C.</p>
              <span
                style="
                  font-family: Arial, sans-serif;
                  font-size: 0.625rem;
                  font-weight: 700;
                  letter-spacing: 0.05em;
                  text-transform: uppercase;
                  color: #4ade80;
                "
              >&#10003; Verified</span>
            </div>
            <p style="margin: 0; font-family: Arial, sans-serif; font-size: 0.6875rem; color: #525252;">Dublin, IE</p>
          </div>
          <p style="margin: 0; font-family: Arial, sans-serif; font-size: 0.6875rem; color: #404040; text-align: right; line-height: 1.4;">Chi-Town 23 Flares</p>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
