<section style="background:#0a0a0a;min-height:100vh;padding:2rem 0 4rem;">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem;">
    <div id="two-col-product" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;">

      <!-- ══════ LEFT: Image ══════ -->
      <div style="min-width:0;">

        <!-- Image wrapper – position:relative so brackets and badges layer correctly -->
        <div style="position:relative;">

          <!-- ── SALE badge (top-left) ── -->
          {%- if product.compare_at_price > product.price or product.tags contains 'sale' -%}
            <div style="position:absolute;top:0.85rem;left:0.85rem;z-index:10;">
              <span style="background:#dc2626;color:#fff;font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;padding:0.25rem 0.6rem;border-radius:2px;display:inline-block;">SALE</span>
            </div>
          {%- endif -%}

          <!-- ── Corner bracket: top-right ── -->
          <div aria-hidden="true" style="position:absolute;top:0;right:0;width:36px;height:36px;pointer-events:none;z-index:8;">
            <div style="position:absolute;top:0;right:0;width:1px;height:36px;background:#C9A84C;opacity:0.8;"></div>
            <div style="position:absolute;top:0;right:0;width:36px;height:1px;background:#C9A84C;opacity:0.8;"></div>
          </div>

          <!-- ── Corner bracket: bottom-left ── -->
          <div aria-hidden="true" style="position:absolute;bottom:0;left:0;width:36px;height:36px;pointer-events:none;z-index:8;">
            <div style="position:absolute;bottom:0;left:0;width:1px;height:36px;background:#C9A84C;opacity:0.8;"></div>
            <div style="position:absolute;bottom:0;left:0;width:36px;height:1px;background:#C9A84C;opacity:0.8;"></div>
          </div>

          <!-- ── Main image (aspect-ratio 3/4) ── -->
          {%- assign main_img = product.featured_image -%}
          <div style="position:relative;aspect-ratio:3/4;background:#111;border-radius:4px;overflow:hidden;">

            {%- if main_img -%}
              <img
                id="product-main-image"
                src="{{ main_img | img_url: '800x' }}"
                alt="{{ product.title | escape }}"
                loading="eager"
                style="width:100%;height:100%;object-fit:cover;display:block;transition:opacity 0.2s ease;"
              >
            {%- endif -%}

            <!-- Bottom gradient overlay -->
            <div style="position:absolute;bottom:0;left:0;right:0;padding:2.5rem 1.25rem 1.25rem;background:linear-gradient(to top,rgba(0,0,0,0.88) 0%,rgba(0,0,0,0.5) 55%,transparent 100%);z-index:4;pointer-events:none;">
              {%- if product.type != blank -%}
                <p style="margin:0 0 0.2rem;font-family:Arial,sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.25em;text-transform:uppercase;color:#C9A84C;">{{ product.type }}</p>
              {%- endif -%}
              <p style="margin:0 0 0.35rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.95rem;font-weight:900;text-transform:uppercase;color:#e5e5e5;line-height:1.2;">{{ product.title }}</p>
              <p style="margin:0;font-family:'Arial Black',Arial,sans-serif;font-size:1.1rem;font-weight:900;color:#C9A84C;" id="image-price">{{ product.selected_or_first_available_variant.price | money }}</p>
            </div>

            <!-- Out of stock overlay -->
            {%- unless product.available -%}
              <div style="position:absolute;inset:0;background:rgba(8,8,8,0.65);display:flex;align-items:center;justify-content:center;z-index:5;">
                <span style="font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#525252;border:1px solid #333;padding:0.4rem 0.85rem;border-radius:2px;">Out of Stock</span>
              </div>
            {%- endunless -%}

          </div><!-- /main image -->
        </div><!-- /image wrapper -->

        <!-- ── Thumbnail strip ── -->
        {%- if product.images.size > 1 -%}
          <div style="display:flex;gap:0.75rem;margin-top:1rem;overflow-x:auto;padding-bottom:0.5rem;">
            {%- for image in product.images -%}
              <button
                class="thumb-btn"
                data-src="{{ image | img_url: '800x' }}"
                onclick="setMainImage('{{ image | img_url: '800x' }}', this)"
                style="flex-shrink:0;width:80px;height:80px;border:2px solid {%- if forloop.first -%}#C9A84C{%- else -%}#1a1a1a{%- endif -%};border-radius:3px;overflow:hidden;background:#111;padding:0;cursor:pointer;"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ image | img_url: '160x' }}" loading="lazy" alt="Thumbnail {{ forloop.index }}" style="width:100%;height:100%;object-fit:cover;display:block;">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div><!-- /LEFT -->

      <!-- ══════ RIGHT: Product info ══════ -->
      <div style="min-width:0;display:flex;flex-direction:column;gap:1.25rem;">

        <!-- Category -->
        {%- if product.type != blank -%}
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;">{{ product.type }}</p>
        {%- endif -%}

        <!-- Title -->
        <h1 style="margin:0;font-family:'Arial Black',Arial,sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:900;color:#e5e5e5;line-height:1.1;text-transform:uppercase;">{{ product.title }}</h1>

        <!-- Price row (price + strikethrough + SAVE badge) -->
        <div style="display:flex;align-items:baseline;gap:0.75rem;flex-wrap:wrap;">
          <span style="font-family:'Arial Black',Arial,sans-serif;font-size:1.75rem;font-weight:900;color:#C9A84C;" id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          <span id="product-compare-price" style="font-family:Arial,sans-serif;font-size:1.1rem;color:#737373;text-decoration:line-through;{%- unless product.compare_at_price > product.price -%}display:none;{%- endunless -%}">{{ product.compare_at_price | money }}</span>
          <span id="product-save-badge" style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;background:#dc2626;color:#fff;padding:0.15rem 0.45rem;border-radius:2px;{%- unless product.compare_at_price > product.price -%}display:none;{%- endunless -%}">
            SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
          </span>
        </div>

        <!-- Short description -->
        {%- if product.description != blank -%}
          <div style="font-family:Arial,sans-serif;font-size:0.9rem;color:#a3a3a3;line-height:1.7;">{{ product.description | truncate: 300 }}</div>
        {%- endif -%}

        <!-- Divider -->
        <div style="height:1px;background:linear-gradient(to right,rgba(201,168,76,0.6),rgba(201,168,76,0.15),transparent);"></div>

        <!-- Variant form -->
        {%- form 'product', product, id: 'product-form' -%}
          <input type="hidden" name="id"       id="variant-id"     value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" id="quantity-input" value="1">

          {%- for option in product.options_with_values -%}
            {%- assign opt_lower = option.name | downcase -%}
            <div style="margin-bottom:1rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
                <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#C9A84C;">
                  {{ option.name }}: <span style="color:#e5e5e5;" id="selected-{{ opt_lower | replace: ' ', '-' }}">{{ option.selected_value }}</span>
                </span>
                {%- if opt_lower == 'size' -%}
                  <a href="/pages/size-guide" style="font-family:Arial,sans-serif;font-size:0.7rem;color:#C9A84C;text-decoration:none;border-bottom:1px solid rgba(201,168,76,0.3);letter-spacing:0.08em;text-transform:uppercase;">Size Guide</a>
                {%- endif -%}
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="opt-btn"
                    data-option-position="{{ option.position }}"
                    data-option-name="{{ opt_lower | replace: ' ', '-' }}"
                    data-value="{{ value | escape }}"
                    onclick="selectOption(this)"
                    style="{%- if opt_lower == 'size' -%}width:52px;height:52px;{%- else -%}padding:0.4rem 1rem;{%- endif -%}font-family:'Arial Black',Arial,sans-serif;font-size:0.75rem;font-weight:900;border-radius:3px;cursor:pointer;transition:all 0.15s;background:{%- if option.selected_value == value -%}#C9A84C;color:#0a0a0a;border:2px solid #C9A84C;{%- else -%}transparent;color:#a3a3a3;border:2px solid #2a2a2a;{%- endif -%}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <!-- Low stock warning -->
          {%- if cv.available -%}
            <div style="display:flex;align-items:center;gap:0.4rem;margin-bottom:0.75rem;">
              <span style="display:inline-block;width:6px;height:6px;background:#ef4444;border-radius:50%;flex-shrink:0;"></span>
              <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.06em;color:#ef4444;">Only 3 left in stock &mdash; order soon</span>
            </div>
          {%- endif -%}

          <!-- Stock badge -->
          {%- assign cv = product.selected_or_first_available_variant -%}
          <div id="stock-badge" style="margin-bottom:0.75rem;min-height:1.25rem;">
            {%- if cv.available -%}
              {%- if cv.inventory_quantity > 0 and cv.inventory_quantity < 5 -%}
                <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#f59e0b;">&#9679; Only {{ cv.inventory_quantity }} left in stock</span>
              {%- endif -%}
            {%- else -%}
              <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#737373;">&#9679; Out of Stock</span>
            {%- endif -%}
          </div>

          <!-- ── Quantity stepper + Add to Cart ── -->
          <div style="display:flex;gap:0.75rem;align-items:stretch;">

            <!-- Qty stepper -->
            <div style="display:inline-flex;align-items:center;border:2px solid #2a2a2a;border-radius:3px;flex-shrink:0;">
              <button type="button" onclick="adjustQty(-1)" aria-label="Decrease quantity"
                style="width:40px;height:52px;background:transparent;border:none;color:#e5e5e5;font-size:1.25rem;cursor:pointer;font-family:'Arial Black',Arial,sans-serif;display:flex;align-items:center;justify-content:center;">&#8722;</button>
              <span id="qty-display" style="min-width:32px;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.9rem;font-weight:900;color:#e5e5e5;">1</span>
              <button type="button" onclick="adjustQty(1)" aria-label="Increase quantity"
                style="width:40px;height:52px;background:transparent;border:none;color:#e5e5e5;font-size:1.25rem;cursor:pointer;font-family:'Arial Black',Arial,sans-serif;display:flex;align-items:center;justify-content:center;">&#43;</button>
            </div>

            <!-- Add to Cart -->
            <button
              type="submit"
              id="add-to-cart-btn"
              style="flex:1;padding:1rem;background:{%- if cv.available -%}#C9A84C{%- else -%}#1a1a1a{%- endif -%};color:{%- if cv.available -%}#0a0a0a{%- else -%}#525252{%- endif -%};border:none;border-radius:3px;font-family:'Arial Black',Arial,sans-serif;font-size:0.85rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;cursor:{%- if cv.available -%}pointer{%- else -%}not-allowed{%- endif -%};"
              {%- unless cv.available -%}disabled{%- endunless -%}
            >
              {%- if cv.available -%}Add to Cart{%- else -%}Out of Stock{%- endif -%}
            </button>

          </div><!-- /qty+atc row -->

        {%- endform -%}

        <!-- ── Free shipping notice ── -->
        <div style="display:flex;align-items:center;gap:0.6rem;padding:0.75rem;background:#0d0d0d;border:1px solid #1a1a1a;border-radius:3px;">
          <span style="color:#C9A84C;font-size:1rem;line-height:1;flex-shrink:0;">&#10003;</span>
          <span style="font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;">Free shipping on orders over <strong style="color:#e5e5e5;">€75</strong></span>
        </div>

        <!-- ── Accordion: Product Details ── -->
        <details class="product-accordion" style="border-top:1px solid #1a1a1a;">
          <summary style="display:flex;align-items:center;justify-content:space-between;padding:1rem 0;cursor:pointer;list-style:none;-webkit-appearance:none;">
            <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#e5e5e5;">Product Details</span>
            <svg class="accordion-chevron" width="16" height="16" fill="none" stroke="#737373" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s ease;" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div style="padding-bottom:1rem;">
            <div style="font-family:Arial,sans-serif;font-size:0.85rem;color:#737373;line-height:1.9;">
              {%- if product.description != blank -%}
                {%- assign detail_lines = product.description | newline_to_br | split: '<br />' -%}
                {%- for line in detail_lines limit: 8 -%}
                  {%- if line != blank -%}
                    <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>{{ line | strip_html | strip }}</span></div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>100% Premium Cotton</span></div>
                <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>Pre-washed &amp; pre-shrunk</span></div>
                <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>Machine washable at 30&deg;C</span></div>
                <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>Limited edition — not restocked</span></div>
              {%- endif -%}
            </div>
          </div>
        </details>

        <!-- ── Accordion: Shipping & Returns ── -->
        <details class="product-accordion" style="border-top:1px solid #1a1a1a;">
          <summary style="display:flex;align-items:center;justify-content:space-between;padding:1rem 0;cursor:pointer;list-style:none;-webkit-appearance:none;">
            <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#e5e5e5;">Shipping &amp; Returns</span>
            <svg class="accordion-chevron" width="16" height="16" fill="none" stroke="#737373" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s ease;" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div style="padding-bottom:1rem;">
            <p style="margin:0 0 0.5rem;font-family:Arial,sans-serif;font-size:0.85rem;color:#737373;line-height:1.7;">Standard delivery 5&ndash;7 working days. Express 2&ndash;3 days.</p>
            <p style="margin:0;font-family:Arial,sans-serif;font-size:0.85rem;color:#737373;line-height:1.7;">Free standard shipping on all EU orders over &euro;150. <a href="/pages/returns" style="color:#C9A84C;text-decoration:none;border-bottom:1px solid rgba(201,168,76,0.4);">Returns policy &rarr;</a></p>
          </div>
        </details>
        <div style="height:1px;background:#1a1a1a;"></div>

      </div><!-- /RIGHT -->
    </div><!-- /two-col-product -->
  </div>
</section>

<style>
  #two-col-product { display:grid; grid-template-columns:1fr 1fr; gap:3rem; align-items:start; }
  @media (max-width:767px) { #two-col-product { grid-template-columns:1fr; gap:2rem; } }
  details[open] .accordion-chevron { transform:rotate(180deg); }
  details summary::-webkit-details-marker { display:none; }
</style>

<script>
(function(){
  var variants = [
    {%- for v in product.variants -%}
    {
      id: {{ v.id }},
      price: {{ v.price }},
      comparePrice: {{ v.compare_at_price | default: 0 }},
      available: {{ v.available }},
      inventoryQty: {{ v.inventory_quantity | default: 0 }},
      option1: {{ v.option1 | json }},
      option2: {{ v.option2 | json }},
      option3: {{ v.option3 | json }},
      image: {% if v.image %}{{ v.image | img_url: '800x' | json }}{% elsif product.featured_image %}{{ product.featured_image | img_url: '800x' | json }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  var sel = {
    1: {{ product.selected_or_first_available_variant.option1 | json }},
    2: {{ product.selected_or_first_available_variant.option2 | json }},
    3: {{ product.selected_or_first_available_variant.option3 | json }}
  };

  function findVariant() {
    return variants.find(function(v) {
      return v.option1 === sel[1]
          && (v.option2 == null || v.option2 === sel[2])
          && (v.option3 == null || v.option3 === sel[3]);
    }) || null;
  }

  function money(cents) {
    return '\u20ac' + (cents / 100).toFixed(2);
  }

  function applyVariant(v) {
    if (!v) return;

    var idEl = document.getElementById('variant-id');
    if (idEl) idEl.value = v.id;

    var priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = money(v.price);

    var imgPriceEl = document.getElementById('image-price');
    if (imgPriceEl) imgPriceEl.textContent = money(v.price);

    var compEl  = document.getElementById('product-compare-price');
    var saveEl  = document.getElementById('product-save-badge');
    if (compEl && saveEl) {
      if (v.comparePrice && v.comparePrice > v.price) {
        compEl.textContent   = money(v.comparePrice);
        compEl.style.display = '';
        var pct = Math.round((v.comparePrice - v.price) / v.comparePrice * 100);
        saveEl.textContent   = 'SAVE ' + pct + '%';
        saveEl.style.display = '';
      } else {
        compEl.style.display = 'none';
        saveEl.style.display = 'none';
      }
    }

    if (v.image) {
      var img = document.getElementById('product-main-image');
      if (img) {
        img.style.opacity = '0';
        img.onload = function() { img.style.opacity = '1'; };
        img.src = v.image;
        document.querySelectorAll('.thumb-btn').forEach(function(tb) {
          tb.style.borderColor = tb.dataset.src === v.image ? '#C9A84C' : '#1a1a1a';
        });
      }
    }

    var badge = document.getElementById('stock-badge');
    if (badge) {
      if (!v.available) {
        badge.innerHTML = '<span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#737373;">&#9679; Out of Stock</span>';
      } else if (v.inventoryQty > 0 && v.inventoryQty < 5) {
        badge.innerHTML = '<span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#f59e0b;">&#9679; Only ' + v.inventoryQty + ' left in stock</span>';
      } else {
        badge.innerHTML = '';
      }
    }

    var btn = document.getElementById('add-to-cart-btn');
    if (btn) {
      if (v.available) {
        btn.disabled         = false;
        btn.textContent      = 'Add to Cart';
        btn.style.background = '#C9A84C';
        btn.style.color      = '#0a0a0a';
        btn.style.cursor     = 'pointer';
      } else {
        btn.disabled         = true;
        btn.textContent      = 'Out of Stock';
        btn.style.background = '#1a1a1a';
        btn.style.color      = '#525252';
        btn.style.cursor     = 'not-allowed';
      }
    }
  }

  window.selectOption = function(btn) {
    var pos  = parseInt(btn.dataset.optionPosition, 10);
    var val  = btn.dataset.value;
    var name = btn.dataset.optionName;

    sel[pos] = val;

    document.querySelectorAll('.opt-btn[data-option-position="' + pos + '"]').forEach(function(b) {
      b.style.background  = 'transparent';
      b.style.color       = '#a3a3a3';
      b.style.borderColor = '#2a2a2a';
    });
    btn.style.background  = '#C9A84C';
    btn.style.color       = '#0a0a0a';
    btn.style.borderColor = '#C9A84C';

    var labelEl = document.getElementById('selected-' + name);
    if (labelEl) labelEl.textContent = val;

    applyVariant(findVariant());
  };

  window.setMainImage = function(src, clickedBtn) {
    var img = document.getElementById('product-main-image');
    if (img) {
      img.style.opacity = '0';
      img.onload = function() { img.style.opacity = '1'; };
      img.src = src;
    }
    document.querySelectorAll('.thumb-btn').forEach(function(tb) {
      tb.style.borderColor = tb === clickedBtn ? '#C9A84C' : '#1a1a1a';
    });
  };

  var _qty = 1;
  window.adjustQty = function(delta) {
    _qty = Math.max(1, _qty + delta);
    var el = document.getElementById('qty-display');
    if (el) el.textContent = _qty;
    var qi = document.getElementById('quantity-input');
    if (qi) qi.value = _qty;
  };

})();
</script>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "limit": 1,
  "settings": [],
  "presets": [{ "name": "Main Product" }]
}
{% endschema %}
