<section
  id="countdown-timer"
  style="
    position: relative;
    background-color: #080808;
    padding: 96px 0;
    overflow: hidden;
  "
>

  <!-- Subtle gold radial glow -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(201,168,76,0.06) 0%, transparent 70%);
      pointer-events: none;
    "
  ></div>

  <div style="position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; text-align: center;">

    <!-- Eyebrow -->
    <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 0.75rem;">
      <div style="height: 1px; width: 32px; background-color: #C9A84C;"></div>
      <span
        style="
          font-family: Arial, sans-serif;
          font-size: 11px;
          font-weight: 900;
          letter-spacing: 0.2em;
          text-transform: uppercase;
          color: #C9A84C;
        "
      >Next Drop</span>
      <div style="height: 1px; width: 32px; background-color: #C9A84C;"></div>
    </div>

    <!-- H2 -->
    <h2
      style="
        margin: 0 0 3rem;
        font-family: 'Arial Black', Arial, sans-serif;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 900;
        text-transform: uppercase;
        color: #e5e5e5;
        letter-spacing: -0.01em;
      "
    >Next Drop</h2>

    <!-- Countdown display -->
    <div
      style="
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
      "
    >

      <!-- Days -->
      <div style="display: flex; flex-direction: column; align-items: center; padding: 0 8px;">
        <div
          style="
            background-color: #0d0d0d;
            border: 1px solid #1a1a1a;
            padding: 20px 28px;
            min-width: 88px;
            text-align: center;
          "
        >
          <span
            id="countdown-days"
            style="
              display: block;
              font-family: 'Arial Black', Arial, sans-serif;
              font-size: 2rem;
              font-weight: 900;
              color: #C9A84C;
              line-height: 1;
              letter-spacing: -0.02em;
              font-variant-numeric: tabular-nums;
            "
          >00</span>
        </div>
        <span
          style="
            margin-top: 10px;
            font-family: Arial, sans-serif;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #737373;
          "
        >Days</span>
      </div>

      <!-- Colon separator -->
      <span
        aria-hidden="true"
        style="
          font-family: 'Arial Black', Arial, sans-serif;
          font-size: 1.75rem;
          font-weight: 900;
          color: #C9A84C;
          padding: 0 4px;
          margin-bottom: 28px;
          line-height: 1;
        "
      >:</span>

      <!-- Hours -->
      <div style="display: flex; flex-direction: column; align-items: center; padding: 0 8px;">
        <div
          style="
            background-color: #0d0d0d;
            border: 1px solid #1a1a1a;
            padding: 20px 28px;
            min-width: 88px;
            text-align: center;
          "
        >
          <span
            id="countdown-hours"
            style="
              display: block;
              font-family: 'Arial Black', Arial, sans-serif;
              font-size: 2rem;
              font-weight: 900;
              color: #C9A84C;
              line-height: 1;
              letter-spacing: -0.02em;
              font-variant-numeric: tabular-nums;
            "
          >00</span>
        </div>
        <span
          style="
            margin-top: 10px;
            font-family: Arial, sans-serif;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #737373;
          "
        >Hours</span>
      </div>

      <!-- Colon separator -->
      <span
        aria-hidden="true"
        style="
          font-family: 'Arial Black', Arial, sans-serif;
          font-size: 1.75rem;
          font-weight: 900;
          color: #C9A84C;
          padding: 0 4px;
          margin-bottom: 28px;
          line-height: 1;
        "
      >:</span>

      <!-- Minutes -->
      <div style="display: flex; flex-direction: column; align-items: center; padding: 0 8px;">
        <div
          style="
            background-color: #0d0d0d;
            border: 1px solid #1a1a1a;
            padding: 20px 28px;
            min-width: 88px;
            text-align: center;
          "
        >
          <span
            id="countdown-minutes"
            style="
              display: block;
              font-family: 'Arial Black', Arial, sans-serif;
              font-size: 2rem;
              font-weight: 900;
              color: #C9A84C;
              line-height: 1;
              letter-spacing: -0.02em;
              font-variant-numeric: tabular-nums;
            "
          >00</span>
        </div>
        <span
          style="
            margin-top: 10px;
            font-family: Arial, sans-serif;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #737373;
          "
        >Minutes</span>
      </div>

      <!-- Colon separator -->
      <span
        aria-hidden="true"
        style="
          font-family: 'Arial Black', Arial, sans-serif;
          font-size: 1.75rem;
          font-weight: 900;
          color: #C9A84C;
          padding: 0 4px;
          margin-bottom: 28px;
          line-height: 1;
        "
      >:</span>

      <!-- Seconds -->
      <div style="display: flex; flex-direction: column; align-items: center; padding: 0 8px;">
        <div
          style="
            background-color: #0d0d0d;
            border: 1px solid #1a1a1a;
            padding: 20px 28px;
            min-width: 88px;
            text-align: center;
          "
        >
          <span
            id="countdown-seconds"
            style="
              display: block;
              font-family: 'Arial Black', Arial, sans-serif;
              font-size: 2rem;
              font-weight: 900;
              color: #C9A84C;
              line-height: 1;
              letter-spacing: -0.02em;
              font-variant-numeric: tabular-nums;
            "
          >00</span>
        </div>
        <span
          style="
            margin-top: 10px;
            font-family: Arial, sans-serif;
            font-size: 0.6875rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #737373;
          "
        >Seconds</span>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Countdown Timer",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Countdown Timer"
    }
  ]
}
{% endschema %}
