<section style="background-color:#0a0a0a;min-height:100vh;padding:4rem 0 5rem;">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">

    <!-- Header -->
    <div style="text-align:center;margin-bottom:3.5rem;">
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:1.25rem;">
        <div style="height:1px;width:40px;background:#C9A84C;"></div>
        <span style="font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.25em;text-transform:uppercase;color:#C9A84C;">Fit</span>
        <div style="height:1px;width:40px;background:#C9A84C;"></div>
      </div>
      <h1 style="margin:0;font-family:'Arial Black',Arial,sans-serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:-0.02em;">Size Guide</h1>
    </div>

    <!-- How to Measure -->
    <div style="max-width:900px;margin:0 auto 3.5rem;">
      <p style="margin:0 0 1.5rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;text-align:center;">How to Measure</p>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;" id="measure-grid">

        <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;text-align:center;">
          <p style="margin:0 0 0.4rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.85rem;font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:0.05em;">Chest</p>
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;line-height:1.6;">Measure around the fullest part of your chest, keeping the tape parallel to the floor.</p>
        </div>

        <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;text-align:center;">
          <p style="margin:0 0 0.4rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.85rem;font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:0.05em;">Waist</p>
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;line-height:1.6;">Measure around your natural waistline, just above your belly button.</p>
        </div>

        <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;text-align:center;">
          <p style="margin:0 0 0.4rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.85rem;font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:0.05em;">Hip</p>
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;line-height:1.6;">Stand with feet together and measure around the widest point of your hips.</p>
        </div>

        <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:1.5rem;text-align:center;">
          <p style="margin:0 0 0.4rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.85rem;font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:0.05em;">Length</p>
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;line-height:1.6;">Measure from the top of the shoulder seam straight down to the bottom hem.</p>
        </div>

      </div>

      <!-- Measurement note -->
      <p style="margin:1.25rem 0 0;text-align:center;font-family:Arial,sans-serif;font-size:0.8rem;color:#525252;font-style:italic;">All measurements in cm. If you are between sizes, we recommend sizing up.</p>
    </div>

    <!-- Tables -->
    <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;gap:3rem;">

      <!-- Hoodies & Sweatshirts -->
      <div>
        <p style="margin:0 0 1rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;">Hoodies &amp; Sweatshirts</p>
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:0.8rem;background:#0d0d0d;border-radius:4px;overflow:hidden;">
            <thead>
              <tr style="background:#C9A84C;">
                <th style="padding:0.75rem 1rem;text-align:left;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Size</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Chest (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Length (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Sleeve (cm)</th>
              </tr>
            </thead>
            <tbody>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XS</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">88&ndash;91</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">65</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">83</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">S</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">92&ndash;96</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">67</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">85</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">M</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">97&ndash;101</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">70</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">87</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">L</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">102&ndash;107</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">72</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">89</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XL</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">108&ndash;114</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">74</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">91</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XXL</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">115&ndash;122</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">76</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">93</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- T-Shirts -->
      <div>
        <p style="margin:0 0 1rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;">T-Shirts</p>
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:0.8rem;background:#0d0d0d;border-radius:4px;overflow:hidden;">
            <thead>
              <tr style="background:#C9A84C;">
                <th style="padding:0.75rem 1rem;text-align:left;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Size</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Chest (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Length (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Shoulder (cm)</th>
              </tr>
            </thead>
            <tbody>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XS</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">84&ndash;87</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">68</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">40</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">S</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">88&ndash;91</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">70</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">42</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">M</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">92&ndash;96</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">72</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">44</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">L</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">97&ndash;102</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">74</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">46</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XL</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">103&ndash;109</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">76</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">48</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XXL</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">110&ndash;117</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">78</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">50</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bottoms / Joggers -->
      <div>
        <p style="margin:0 0 1rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;">Bottoms / Joggers</p>
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:0.8rem;background:#0d0d0d;border-radius:4px;overflow:hidden;">
            <thead>
              <tr style="background:#C9A84C;">
                <th style="padding:0.75rem 1rem;text-align:left;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Size</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Waist (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Hip (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Inseam (cm)</th>
              </tr>
            </thead>
            <tbody>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XS</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">66&ndash;69</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">88&ndash;91</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">74</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">S</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">70&ndash;73</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">92&ndash;95</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">76</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">M</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">74&ndash;77</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">96&ndash;99</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">78</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">L</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">78&ndash;82</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">100&ndash;104</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">80</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XL</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">83&ndash;88</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">105&ndash;110</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">80</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">XXL</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">89&ndash;95</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">111&ndash;118</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">81</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Cargo Pants -->
      <div>
        <p style="margin:0 0 1rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;">Cargo Pants</p>
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;font-family:Arial,sans-serif;font-size:0.8rem;background:#0d0d0d;border-radius:4px;overflow:hidden;">
            <thead>
              <tr style="background:#C9A84C;">
                <th style="padding:0.75rem 1rem;text-align:left;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Waist (in)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Hip (cm)</th>
                <th style="padding:0.75rem 1rem;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;">Inseam (cm)</th>
              </tr>
            </thead>
            <tbody>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">28</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">88</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">78</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">30</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">92</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">79</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">32</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">96</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">80</td></tr>
              <tr style="background:#111;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">34</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">100</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">81</td></tr>
              <tr style="background:#0d0d0d;"><td style="padding:0.65rem 1rem;color:#e5e5e5;font-weight:700;">36</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">104</td><td style="padding:0.65rem 1rem;text-align:center;color:#a3a3a3;">82</td></tr>
