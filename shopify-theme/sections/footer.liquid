<footer class="site-footer" role="contentinfo">
  <div class="footer-gold-line" aria-hidden="true"></div>

  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <span class="footer-logo gold-shimmer">THE 00s VERSION</span>
        <p class="footer-tagline">
          Premium streetwear rooted in early 2000s culture.
          Every piece tells a story. Every drop is an era.
        </p>
        <div class="footer-socials">
          <a href="https://instagram.com/the00sversion" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">IG</a>
          <a href="https://tiktok.com/@the00sversion" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="TikTok">TT</a>
          <a href="https://twitter.com/the00sversion" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Twitter/X">TW</a>
        </div>
      </div>

      <!-- Shop links -->
      <div class="footer-col">
        <h4 class="footer-heading">Shop</h4>
        <ul class="footer-links">
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/collections/new-drops">New Drops</a></li>
          <li><a href="/collections/sets">Sets</a></li>
          <li><a href="/collections/tops">Tops</a></li>
          <li><a href="/collections/bottoms">Bottoms</a></li>
          <li><a href="/collections/jackets">Jackets</a></li>
          <li><a href="/collections/accessories">Accessories</a></li>
        </ul>
      </div>

      <!-- Info links -->
      <div class="footer-col">
        <h4 class="footer-heading">Info</h4>
        <ul class="footer-links">
          <li><a href="/pages/size-guide">Size Guide</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/track-order">Track Order</a></li>
          <li><a href="/pages/returns">Shipping &amp; Returns</a></li>
          <li><a href="/pages/cookie-policy">Cookie Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-copy">&copy; {{ 'now' | date: '%Y' }} The 00s Version. All rights reserved.</p>
      <div class="footer-legal-links">
        <a href="/pages/privacy-policy">Privacy Policy</a>
        <a href="/pages/terms">Terms of Service</a>
        <a href="/pages/returns">Returns Policy</a>
        <a href="/pages/cookie-policy">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "settings": []
}
{% endschema %}
