<section
  id="email-signup"
  style="
    position: relative;
    background: linear-gradient(to bottom, #0d0d0d, #111111);
    padding: 80px 0;
    border-top: 1px solid #C9A84C;
    border-bottom: 1px solid #C9A84C;
  "
>
  <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; text-align: center;">

    <!-- Eyebrow -->
    <div style="display: flex; align-items: center; justify-content: center; gap: 12px; margin-bottom: 0.75rem;">
      <div style="height: 1px; width: 32px; background-color: #C9A84C;"></div>
      <span
        style="
          font-family: Arial, sans-serif;
          font-size: 11px;
          font-weight: 900;
          letter-spacing: 0.2em;
          text-transform: uppercase;
          color: #C9A84C;
        "
      >First to Know</span>
      <div style="height: 1px; width: 32px; background-color: #C9A84C;"></div>
    </div>

    <!-- H2 -->
    <h2
      style="
        margin: 0 0 1rem;
        font-family: 'Arial Black', Arial, sans-serif;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 900;
        text-transform: uppercase;
        color: #e5e5e5;
        letter-spacing: -0.01em;
      "
    >Join the Inner Circle</h2>

    <!-- Subtext -->
    <p
      style="
        margin: 0 auto 2.5rem;
        max-width: 440px;
        font-family: Arial, sans-serif;
        font-size: 0.9375rem;
        line-height: 1.7;
        color: #737373;
      "
    >
      Get early access to every drop, exclusive member pricing,
      and insider news before anyone else hears about it.
    </p>

    {%- form 'customer', id: 'email-signup-form' -%}

      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <!-- Success state -->
        <div
          style="
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background-color: rgba(34,197,94,0.1);
            border: 1px solid rgba(34,197,94,0.3);
            border-radius: 2px;
            padding: 14px 24px;
          "
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          <span style="font-family: Arial, sans-serif; font-size: 0.9375rem; font-weight: 700; color: #22c55e;">
            You&rsquo;re in. Watch your inbox.
          </span>
        </div>

      {%- else -%}

        {%- if form.errors -%}
          <div
            style="
              margin-bottom: 1rem;
              font-family: Arial, sans-serif;
              font-size: 0.8125rem;
              color: #ef4444;
            "
          >
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <!-- Email input + submit -->
        <div
          style="
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 440px;
            margin: 0 auto;
          "
          class="email-signup-row"
        >
          <label for="email-signup-input" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0);">
            Email address
          </label>
          <input
            id="email-signup-input"
            type="email"
            name="contact[email]"
            placeholder="your@email.com"
            required
            autocomplete="email"
            style="
              flex: 1;
              background-color: #080808;
              border: 1px solid #1a1a1a;
              border-radius: 2px;
              padding: 14px 18px;
              font-family: Arial, sans-serif;
              font-size: 0.9375rem;
              color: #e5e5e5;
              outline: none;
              transition: border-color 0.2s ease;
              width: 100%;
              box-sizing: border-box;
            "
            onfocus="this.style.borderColor='#C9A84C'"
            onblur="this.style.borderColor='#1a1a1a'"
          >
          <button
            type="submit"
            class="btn-gold"
            style="white-space: nowrap; width: 100%;"
          >Join</button>
        </div>

        <p
          style="
            margin: 1.25rem auto 0;
            font-family: Arial, sans-serif;
            font-size: 0.6875rem;
            color: #737373;
            letter-spacing: 0.04em;
          "
        >No spam. Unsubscribe any time. We respect your privacy.</p>

      {%- endif -%}

    {%- endform -%}

  </div>
</section>

<style>
  @media (min-width: 480px) {
    .email-signup-row {
      flex-direction: row !important;
    }
    .email-signup-row button {
      width: auto !important;
    }
  }
</style>

{% schema %}
{
  "name": "Email Signup",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Email Signup"
    }
  ]
}
{% endschema %}
