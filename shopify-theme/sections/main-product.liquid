<section style="background-color:#080808;min-height:100vh;padding:2rem 0 4rem;">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">

    <!-- Breadcrumb -->
    <nav style="margin-bottom:2rem;font-family:Arial,sans-serif;font-size:0.75rem;letter-spacing:0.08em;color:#525252;">
      <a href="/" style="color:#525252;text-decoration:none;">Home</a>
      <span style="margin:0 0.5rem;color:#333;">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}" style="color:#525252;text-decoration:none;">{{ collection.title }}</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
      {%- else -%}
        <a href="/collections/all" style="color:#525252;text-decoration:none;">Shop</a>
        <span style="margin:0 0.5rem;color:#333;">/</span>
      {%- endif -%}
      <span style="color:#a3a3a3;">{{ product.title }}</span>
    </nav>

    <!-- Two-column layout -->
    <div id="two-col-product" style="display:grid;grid-template-columns:1fr;gap:3rem;align-items:start;">

      <!-- LEFT: Images -->
      <div style="position:relative;">

        <!-- Badges -->
        <div style="position:absolute;top:1rem;left:1rem;z-index:10;display:flex;flex-direction:column;gap:0.5rem;">
          {%- if product.tags contains 'sale' or product.compare_at_price > product.price -%}
            <span style="background:#dc2626;color:#fff;font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;padding:0.25rem 0.6rem;border-radius:2px;">Sale</span>
          {%- endif -%}
          {%- if product.tags contains 'new' -%}
            <span style="background:#e5e5e5;color:#080808;font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;padding:0.25rem 0.6rem;border-radius:2px;">New</span>
          {%- endif -%}
          {%- if product.tags contains 'bestseller' -%}
            <span style="background:#C9A84C;color:#080808;font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;padding:0.25rem 0.6rem;border-radius:2px;">Bestseller</span>
          {%- endif -%}
          {%- if product.tags contains 'limited' -%}
            <span style="background:#1a1a1a;color:#C9A84C;border:1px solid #C9A84C;font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;padding:0.25rem 0.6rem;border-radius:2px;">Limited</span>
          {%- endif -%}
        </div>

        <!-- Main image -->
        {%- assign main_img = product.selected_or_first_available_variant.image | default: product.featured_image | default: product.images.first -%}
        <div style="background:#111;border-radius:4px;overflow:hidden;position:relative;" id="main-image-wrap">
          {%- if main_img -%}
            <img
              id="product-main-image"
              src="{{ main_img | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              loading="eager"
              style="width:100%;height:auto;max-height:640px;object-fit:contain;display:block;transition:opacity 0.2s ease;"
            >
          {%- else -%}
            <div style="width:100%;min-height:420px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.5rem;">
              <span style="font-family:Arial,sans-serif;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;color:#525252;">{{ product.type }}</span>
              <span style="font-family:'Arial Black',Arial,sans-serif;font-size:1rem;font-weight:900;color:#737373;">{{ product.title }}</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Thumbnail strip -->
        {%- if product.images.size > 1 -%}
          <div style="display:flex;gap:0.75rem;margin-top:1rem;overflow-x:auto;padding-bottom:0.5rem;" id="thumb-strip">
            {%- for image in product.images -%}
              <button
                class="thumb-btn"
                data-src="{{ image | image_url: width: 800 }}"
                onclick="setMainImage('{{ image | image_url: width: 800 }}', this)"
                style="flex-shrink:0;width:80px;height:80px;border:2px solid {%- if forloop.first -%}#C9A84C{%- else -%}#1a1a1a{%- endif -%};border-radius:3px;overflow:hidden;background:#111;padding:0;cursor:pointer;transition:border-color 0.15s;"
                aria-label="View image {{ forloop.index }}"
              >
                {{ image | image_url: width: 160 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;display:block;' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- RIGHT: Product info -->
      <div style="display:flex;flex-direction:column;gap:1.25rem;">

        <!-- Category -->
        {%- if product.type != blank -%}
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#C9A84C;">{{ product.type }}</p>
        {%- endif -%}

        <!-- Title -->
        <h1 style="margin:0;font-family:'Arial Black',Arial,sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:900;color:#e5e5e5;line-height:1.1;text-transform:uppercase;letter-spacing:-0.01em;">{{ product.title }}</h1>

        <!-- Price -->
        <div style="display:flex;align-items:baseline;gap:0.75rem;flex-wrap:wrap;" id="price-block">
          <span style="font-family:'Arial Black',Arial,sans-serif;font-size:1.75rem;font-weight:900;color:#C9A84C;" id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          <span id="product-compare-price" style="font-family:Arial,sans-serif;font-size:1.1rem;color:#dc2626;text-decoration:line-through;{%- unless product.compare_at_price > product.price -%}display:none;{%- endunless -%}">{{ product.compare_at_price | money }}</span>
          <span id="product-save-badge" style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;background:#dc2626;color:#fff;padding:0.15rem 0.4rem;border-radius:2px;{%- unless product.compare_at_price > product.price -%}display:none;{%- endunless -%}">
            SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
          </span>
        </div>

        <!-- Description -->
        {%- if product.description != blank -%}
          <div style="font-family:Arial,sans-serif;font-size:0.9rem;color:#a3a3a3;line-height:1.7;">{{ product.description | truncate: 300 }}</div>
        {%- endif -%}

        <!-- Divider -->
        <div style="height:1px;background:linear-gradient(to right,#C9A84C,#C9A84C33,transparent);margin:0.25rem 0;"></div>

        <!-- Variant form -->
        {%- form 'product', product, id: 'product-form', data-product-id: product.id -%}
          <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" id="quantity-input" value="1">

          {%- for option in product.options_with_values -%}
            {%- assign option_name_lower = option.name | downcase -%}

            {%- if option_name_lower == 'color' or option_name_lower == 'colour' -%}
              <!-- Color selector -->
              <div style="margin-bottom:1rem;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
                  <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#e5e5e5;">
                    Colour: <span style="color:#C9A84C;" id="selected-colour">{{ option.selected_value }}</span>
                  </span>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="opt-btn"
                      data-option-position="{{ option.position }}"
                      data-option-name="colour"
                      data-value="{{ value | escape }}"
                      onclick="selectOption(this)"
                      style="padding:0.4rem 1rem;font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;border-radius:3px;cursor:pointer;transition:all 0.15s;background:{%- if option.selected_value == value -%}#C9A84C;color:#080808;border:2px solid #C9A84C;{%- else -%}transparent;color:#a3a3a3;border:2px solid #2a2a2a;{%- endif -%}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>

            {%- elsif option_name_lower == 'size' -%}
              <!-- Size selector -->
              <div style="margin-bottom:1rem;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
                  <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#e5e5e5;">
                    Size: <span style="color:#C9A84C;" id="selected-size">{{ option.selected_value }}</span>
                  </span>
                  <a href="/pages/size-guide" style="font-family:Arial,sans-serif;font-size:0.7rem;color:#C9A84C;text-decoration:none;letter-spacing:0.08em;text-transform:uppercase;border-bottom:1px solid #C9A84C33;">Size Guide</a>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="opt-btn"
                      data-option-position="{{ option.position }}"
                      data-option-name="size"
                      data-value="{{ value | escape }}"
                      onclick="selectOption(this)"
                      style="width:52px;height:52px;font-family:'Arial Black',Arial,sans-serif;font-size:0.75rem;font-weight:900;border-radius:3px;cursor:pointer;transition:all 0.15s;background:{%- if option.selected_value == value -%}#C9A84C;color:#080808;border:2px solid #C9A84C;{%- else -%}transparent;color:#a3a3a3;border:2px solid #2a2a2a;{%- endif -%}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>

            {%- else -%}
              <!-- Generic option selector -->
              <div style="margin-bottom:1rem;">
                <div style="margin-bottom:0.75rem;">
                  <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#e5e5e5;">
                    {{ option.name }}: <span style="color:#C9A84C;" id="selected-{{ option.name | downcase | replace: ' ', '-' }}">{{ option.selected_value }}</span>
                  </span>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="opt-btn"
                      data-option-position="{{ option.position }}"
                      data-option-name="{{ option.name | downcase | replace: ' ', '-' }}"
                      data-value="{{ value | escape }}"
                      onclick="selectOption(this)"
                      style="padding:0.4rem 1rem;font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;border-radius:3px;cursor:pointer;transition:all 0.15s;background:{%- if option.selected_value == value -%}#C9A84C;color:#080808;border:2px solid #C9A84C;{%- else -%}transparent;color:#a3a3a3;border:2px solid #2a2a2a;{%- endif -%}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          <!-- Stock badge -->
          <div id="stock-badge" style="margin-bottom:0.75rem;min-height:1.25rem;">
            {%- assign cv = product.selected_or_first_available_variant -%}
            {%- if cv.available -%}
              {%- if cv.inventory_quantity > 0 and cv.inventory_quantity < 5 -%}
                <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#f59e0b;">&#9679; Only {{ cv.inventory_quantity }} left in stock</span>
              {%- endif -%}
            {%- else -%}
              <span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#737373;">&#9679; Out of Stock</span>
            {%- endif -%}
          </div>

          <!-- Quantity stepper -->
          <div style="margin-bottom:1rem;">
            <span style="display:block;font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#e5e5e5;margin-bottom:0.5rem;">Quantity</span>
            <div style="display:flex;align-items:center;gap:0;border:2px solid #2a2a2a;border-radius:3px;width:fit-content;">
              <button type="button" onclick="adjustQty(-1)" style="width:44px;height:44px;background:transparent;border:none;color:#e5e5e5;font-size:1.25rem;cursor:pointer;font-family:'Arial Black',Arial,sans-serif;display:flex;align-items:center;justify-content:center;" aria-label="Decrease quantity">&#8722;</button>
              <span id="qty-display" style="min-width:40px;text-align:center;font-family:'Arial Black',Arial,sans-serif;font-size:0.9rem;font-weight:900;color:#e5e5e5;">1</span>
              <button type="button" onclick="adjustQty(1)" style="width:44px;height:44px;background:transparent;border:none;color:#e5e5e5;font-size:1.25rem;cursor:pointer;font-family:'Arial Black',Arial,sans-serif;display:flex;align-items:center;justify-content:center;" aria-label="Increase quantity">&#43;</button>
            </div>
          </div>

          <!-- Add to Cart button -->
          <button
            type="submit"
            id="add-to-cart-btn"
            class="btn-gold"
            style="width:100%;padding:1rem;font-size:0.85rem;letter-spacing:0.15em;{%- unless cv.available -%}background:#1a1a1a;color:#525252;cursor:not-allowed;opacity:1;{%- endunless -%}"
            {%- unless cv.available -%}disabled{%- endunless -%}
          >
            {%- if cv.available -%}Add to Cart{%- else -%}Out of Stock{%- endif -%}
          </button>

        {%- endform -%}

        <!-- Free shipping note -->
        <div style="display:flex;align-items:center;gap:0.5rem;padding:0.75rem;background:#0d0d0d;border:1px solid #1a1a1a;border-radius:3px;">
          <span style="color:#C9A84C;font-size:0.9rem;">&#10003;</span>
          <span style="font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;">Free shipping on orders over <strong style="color:#e5e5e5;">€150</strong></span>
        </div>

        <!-- Divider -->
        <div style="height:1px;background:#1a1a1a;"></div>

        <!-- Product details -->
        <div>
          <p style="margin:0 0 0.75rem;font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:#e5e5e5;">Product Details</p>
          <div style="font-family:Arial,sans-serif;font-size:0.85rem;color:#737373;line-height:1.9;">
            {%- if product.description != blank -%}
              {%- assign detail_lines = product.description | newline_to_br | split: '<br />' -%}
              {%- for line in detail_lines limit: 6 -%}
                {%- if line != blank -%}
                  <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>{{ line | strip_html | strip }}</span></div>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>100% Premium Cotton</span></div>
              <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>Pre-washed &amp; pre-shrunk</span></div>
              <div style="display:flex;gap:0.5rem;"><span style="color:#C9A84C;flex-shrink:0;">&mdash;</span><span>Machine washable at 30&deg;C</span></div>
            {%- endif -%}
          </div>
        </div>

        <!-- Shipping note -->
        <div style="padding:1rem;background:#0d0d0d;border:1px solid #1a1a1a;border-radius:3px;">
          <p style="margin:0 0 0.25rem;font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#e5e5e5;">Shipping</p>
          <p style="margin:0;font-family:Arial,sans-serif;font-size:0.8rem;color:#737373;line-height:1.6;">Standard delivery 5&ndash;7 working days. Express 2&ndash;3 days. Free standard shipping on all EU orders over &euro;150.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #two-col-product { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: start; }
  @media(min-width:768px){
    #two-col-product { grid-template-columns: 55% 1fr; }
  }
</style>

<script>
(function(){

  /* ── Variant data from Liquid ─────────────────────────────────────── */
  var variants = [
    {%- for v in product.variants -%}
    {
      id: {{ v.id }},
      price: {{ v.price }},
      comparePrice: {{ v.compare_at_price | default: 0 }},
      available: {{ v.available }},
      inventoryQty: {{ v.inventory_quantity | default: 0 }},
      option1: {{ v.option1 | json }},
      option2: {{ v.option2 | json }},
      option3: {{ v.option3 | json }},
      image: {% if v.image %}{{ v.image | image_url: width: 800 | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  /* ── Track currently selected options (keyed by position 1/2/3) ──── */
  var sel = {
    1: {{ product.selected_or_first_available_variant.option1 | json }},
    2: {{ product.selected_or_first_available_variant.option2 | json }},
    3: {{ product.selected_or_first_available_variant.option3 | json }}
  };

  function findVariant() {
    return variants.find(function(v) {
      return v.option1 === sel[1]
          && (v.option2 == null || v.option2 === sel[2])
          && (v.option3 == null || v.option3 === sel[3]);
    }) || null;
  }

  function money(cents) {
    return '€' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function applyVariant(v) {
    if (!v) return;

    /* hidden id input */
    var idEl = document.getElementById('variant-id');
    if (idEl) idEl.value = v.id;

    /* price */
    var priceEl = document.getElementById('product-price');
    if (priceEl) priceEl.textContent = money(v.price);

    /* compare price + save badge */
    var compEl  = document.getElementById('product-compare-price');
    var saveEl  = document.getElementById('product-save-badge');
    if (compEl && saveEl) {
      if (v.comparePrice && v.comparePrice > v.price) {
        compEl.textContent   = money(v.comparePrice);
        compEl.style.display = '';
        var pct = Math.round((v.comparePrice - v.price) / v.comparePrice * 100);
        saveEl.textContent   = 'SAVE ' + pct + '%';
        saveEl.style.display = '';
      } else {
        compEl.style.display = 'none';
        saveEl.style.display = 'none';
      }
    }

    /* image — swap if the variant has its own image */
    if (v.image) {
      var img = document.getElementById('product-main-image');
      if (img) {
        img.style.opacity = '0';
        img.onload = function() { img.style.opacity = '1'; };
        img.src = v.image;
        /* sync thumbnail borders */
        document.querySelectorAll('.thumb-btn').forEach(function(tb) {
          tb.style.borderColor = tb.dataset.src === v.image ? '#C9A84C' : '#1a1a1a';
        });
      }
    }

    /* stock badge */
    var badge = document.getElementById('stock-badge');
    if (badge) {
      if (!v.available) {
        badge.innerHTML = '<span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#737373;">&#9679; Out of Stock</span>';
      } else if (v.inventoryQty > 0 && v.inventoryQty < 5) {
        badge.innerHTML = '<span style="font-family:Arial,sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.1em;color:#f59e0b;">&#9679; Only ' + v.inventoryQty + ' left in stock</span>';
      } else {
        badge.innerHTML = '';
      }
    }

    /* add-to-cart button */
    var btn = document.getElementById('add-to-cart-btn');
    if (btn) {
      if (v.available) {
        btn.disabled             = false;
        btn.textContent          = 'Add to Cart';
        btn.style.background     = 'linear-gradient(135deg,#C9A84C,#A8892E)';
        btn.style.color          = '#080808';
        btn.style.cursor         = 'pointer';
      } else {
        btn.disabled             = true;
        btn.textContent          = 'Out of Stock';
        btn.style.background     = '#1a1a1a';
        btn.style.color          = '#525252';
        btn.style.cursor         = 'not-allowed';
      }
    }
  }

  /* ── Called when any option button is clicked ────────────────────── */
  window.selectOption = function(btn) {
    var pos   = parseInt(btn.dataset.optionPosition, 10);
    var value = btn.dataset.value;
    var name  = btn.dataset.optionName;

    /* update tracked selection */
    sel[pos] = value;

    /* update button styles for THIS option group only */
    document.querySelectorAll('.opt-btn[data-option-position="' + pos + '"]')
      .forEach(function(b) {
        b.style.background   = 'transparent';
        b.style.color        = '#a3a3a3';
        b.style.borderColor  = '#2a2a2a';
      });
    btn.style.background  = '#C9A84C';
    btn.style.color       = '#080808';
    btn.style.borderColor = '#C9A84C';

    /* update label text */
    var labelEl = document.getElementById('selected-' + name);
    if (labelEl) labelEl.textContent = value;

    /* find + apply matching variant */
    applyVariant(findVariant());
  };

  /* ── Thumbnail click ─────────────────────────────────────────────── */
  window.setMainImage = function(src, clickedBtn) {
    var img = document.getElementById('product-main-image');
    if (img) {
      img.style.opacity = '0';
      img.onload = function() { img.style.opacity = '1'; };
      img.src = src;
    }
    document.querySelectorAll('.thumb-btn').forEach(function(tb) {
      tb.style.borderColor = tb === clickedBtn ? '#C9A84C' : '#1a1a1a';
    });
  };

  /* ── Quantity stepper ────────────────────────────────────────────── */
  var _qty = 1;
  window.adjustQty = function(delta) {
    _qty = Math.max(1, _qty + delta);
    var el = document.getElementById('qty-display');
    if (el) el.textContent = _qty;
    var qi = document.getElementById('quantity-input');
    if (qi) qi.value = _qty;
  };

})();
</script>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Main Product"
    }
  ]
}
{% endschema %}
