<section style="background-color:#0a0a0a;min-height:100vh;padding:4rem 0 5rem;">
  <div style="max-width:1280px;margin:0 auto;padding:0 1.5rem">

    <!-- Header -->
    <div style="text-align:center;margin-bottom:3.5rem;">
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:1.25rem;">
        <div style="height:1px;width:40px;background:#C9A84C;"></div>
        <span style="font-family:Arial,sans-serif;font-size:0.65rem;font-weight:900;letter-spacing:0.25em;text-transform:uppercase;color:#C9A84C;">Shipping</span>
        <div style="height:1px;width:40px;background:#C9A84C;"></div>
      </div>
      <h1 style="margin:0 0 1rem;font-family:'Arial Black',Arial,sans-serif;font-size:clamp(2rem,5vw,3.5rem);font-weight:900;color:#e5e5e5;text-transform:uppercase;letter-spacing:-0.02em;">Track Your Order</h1>
      <p style="margin:0 auto;max-width:480px;font-family:Arial,sans-serif;font-size:0.9rem;color:#737373;line-height:1.7;">Enter your order number and email address to check your order status.</p>
    </div>

    <div style="max-width:560px;margin:0 auto;">

      <!-- Order lookup form -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:2.5rem;margin-bottom:2.5rem;">
        <p style="margin:0 0 1.5rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;color:#e5e5e5;">Order Lookup</p>

        <form id="track-order-form" onsubmit="handleTrackSubmit(event);" style="display:flex;flex-direction:column;gap:1.25rem;">

          <div>
            <label for="order-number" style="display:block;font-family:Arial,sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#737373;margin-bottom:0.5rem;">Order Number</label>
            <input
              type="text"
              id="order-number"
              name="order_number"
              placeholder="#1234"
              autocomplete="off"
              style="width:100%;box-sizing:border-box;background:#111;border:1px solid #2a2a2a;border-radius:3px;color:#e5e5e5;font-family:Arial,sans-serif;font-size:0.875rem;padding:0.75rem 1rem;outline:none;transition:border-color 0.15s;"
              onfocus="this.style.borderColor='#C9A84C'"
              onblur="this.style.borderColor='#2a2a2a'"
            >
          </div>

          <div>
            <label for="order-email" style="display:block;font-family:Arial,sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#737373;margin-bottom:0.5rem;">Email Address</label>
            <input
              type="email"
              id="order-email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              style="width:100%;box-sizing:border-box;background:#111;border:1px solid #2a2a2a;border-radius:3px;color:#e5e5e5;font-family:Arial,sans-serif;font-size:0.875rem;padding:0.75rem 1rem;outline:none;transition:border-color 0.15s;"
              onfocus="this.style.borderColor='#C9A84C'"
              onblur="this.style.borderColor='#2a2a2a'"
            >
          </div>

          <button type="submit" class="btn-gold" style="width:100%;padding:0.9rem;font-size:0.8rem;letter-spacing:0.15em;margin-top:0.25rem;">Track Order</button>

        </form>

        <!-- Result message (hidden by default) -->
        <div id="track-result" style="display:none;margin-top:1.5rem;padding:1.25rem;background:#111;border:1px solid #1a1a1a;border-left:2px solid #C9A84C;border-radius:3px;">
          <p style="margin:0 0 0.5rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;color:#e5e5e5;">Check Your Email</p>
          <p style="margin:0 0 1rem;font-family:Arial,sans-serif;font-size:0.825rem;color:#a3a3a3;line-height:1.7;">Your tracking link was sent to your confirmation email. You can also log in to your account to view full order status and tracking details.</p>
          <a href="/account" class="btn-outline-gold" style="display:inline-block;text-decoration:none;font-size:0.75rem;padding:0.5rem 1.25rem;">View My Account</a>
        </div>
      </div>

      <!-- Order timeline illustration -->
      <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:4px;padding:2rem;">
        <p style="margin:0 0 1.75rem;font-family:'Arial Black',Arial,sans-serif;font-size:0.8rem;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;color:#e5e5e5;text-align:center;">Order Journey</p>

        <div style="display:flex;align-items:flex-start;justify-content:space-between;position:relative;">

          <!-- Connector line -->
          <div style="position:absolute;top:20px;left:calc(12.5% + 10px);right:calc(12.5% + 10px);height:2px;background:linear-gradient(to right,#C9A84C,#C9A84C44,#2a2a2a,#2a2a2a);z-index:0;"></div>

          {%- assign timeline_steps = 'Confirmed,Processing,Shipped,Delivered' | split: ',' -%}
          {%- assign timeline_icons = '&#10003;,&#8943;,&#128666;,&#127968;' | split: ',' -%}
          {%- for step in timeline_steps -%}
            {%- assign is_done = false -%}
            {%- if forloop.index <= 2 -%}{%- assign is_done = true -%}{%- endif -%}
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;width:25%;position:relative;z-index:1;">
              <div style="width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.9rem;
              {%- if is_done -%}
                background:#C9A84C;color:#0a0a0a;border:2px solid #C9A84C;
              {%- else -%}
                background:#111;color:#333;border:2px solid #2a2a2a;
              {%- endif -%}">{{ timeline_icons[forloop.index0] }}</div>
              <span style="font-family:Arial,sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;text-align:center;
              {%- if is_done -%}color:#C9A84C;{%- else -%}color:#525252;{%- endif -%}">{{ step }}</span>
            </div>
          {%- endfor -%}

        </div>

        <p style="margin:1.75rem 0 0;text-align:center;font-family:Arial,sans-serif;font-size:0.75rem;color:#525252;line-height:1.6;">Typical delivery: <strong style="color:#a3a3a3;">5&ndash;7 working days</strong> standard &bull; <strong style="color:#a3a3a3;">2&ndash;3 days</strong> express</p>
      </div>

    </div>
  </div>
</section>

<script>
  function handleTrackSubmit(e) {
    e.preventDefault();
    var orderNum = document.getElementById('order-number').value.trim();
    var email = document.getElementById('order-email').value.trim();
    if (!orderNum || !email) {
      return;
    }
    document.getElementById('track-result').style.display = 'block';
    document.getElementById('track-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>

{% schema %}
{
  "name": "Page Track Order",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Track Order"
    }
  ]
}
{% endschema %}
