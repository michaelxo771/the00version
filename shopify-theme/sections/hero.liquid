<section
  id="hero"
  style="
    position: relative;
    min-height: 92vh;
    background-color: #080808;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding: 96px 0 48px;
  "
>

  <!-- Background grid pattern -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    "
  ></div>

  <!-- Radial gold glow -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(201,168,76,0.08) 0%, transparent 65%);
      pointer-events: none;
    "
  ></div>

  <!-- Side decorative lines (desktop only) -->
  <div
    aria-hidden="true"
    class="hero-side-line hero-side-left"
    style="
      position: absolute;
      left: 32px;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 192px;
      background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.3), transparent);
      display: none;
    "
  ></div>
  <div
    aria-hidden="true"
    class="hero-side-line hero-side-right"
    style="
      position: absolute;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 192px;
      background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.3), transparent);
      display: none;
    "
  ></div>

  <!-- Content -->
  <div
    style="
      position: relative;
      z-index: 1;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 1.5rem;
      text-align: center;
      width: 100%;
    "
  >

    <!-- Eyebrow -->
    <div
      style="
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 1rem;
      "
    >
      <div style="height: 1px; width: 40px; background-color: rgba(201,168,76,0.5);"></div>
      <span
        style="
          font-family: Arial, sans-serif;
          font-size: 10px;
          font-weight: 900;
          letter-spacing: 0.4em;
          text-transform: uppercase;
          color: #C9A84C;
        "
      >Est. 2024 &mdash; Premium Streetwear</span>
      <div style="height: 1px; width: 40px; background-color: rgba(201,168,76,0.5);"></div>
    </div>

    <!-- H1 -->
    <h1 style="margin: 0; line-height: 1; font-family: 'Arial Black', Arial, sans-serif;">
      <span
        class="gold-shimmer"
        style="
          display: block;
          font-size: clamp(3rem, 10vw, 8rem);
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: -0.02em;
          line-height: 1;
        "
      >THE 00s</span>
      <span
        style="
          display: block;
          font-size: clamp(1.4rem, 4.5vw, 4rem);
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.3em;
          color: #e5e5e5;
          margin-top: 0.125rem;
        "
      >VERSION</span>
    </h1>

    <!-- Cycling era text -->
    <p
      style="
        margin: 1rem 0 0.75rem;
        font-family: Arial, sans-serif;
        font-size: clamp(0.875rem, 2vw, 1rem);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: rgba(201,168,76,0.8);
        min-height: 1.5em;
      "
    >
      <span id="cycling-text">Sean John Era.</span>
    </p>

    <!-- Tagline -->
    <p
      style="
        margin: 0.5rem auto 1.75rem;
        max-width: 380px;
        font-family: Arial, sans-serif;
        font-size: 0.875rem;
        color: #525252;
        line-height: 1.7;
      "
    >
      Premium streetwear rooted in early 2000s culture.
      Every piece tells a story. Every drop is an era.
    </p>

    <!-- CTAs -->
    <div
      style="
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
      "
    >
      <a href="/collections/all" class="btn-gold">Shop the Collection</a>
      <a href="/collections/new-drops" class="btn-outline-gold">New Drops</a>
    </div>

    <!-- Stats — three items with value + label two-line format -->
    <div
      style="
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid #1a1a1a;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 2rem 4rem;
      "
    >

      <div style="text-align: center;">
        <p
          class="gold-text"
          style="
            margin: 0;
            font-family: 'Arial Black', Arial, sans-serif;
            font-size: clamp(1rem, 2vw, 1.25rem);
            font-weight: 900;
          "
        >100%</p>
        <p
          style="
            margin: 2px 0 0;
            font-family: Arial, sans-serif;
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #525252;
          "
        >Premium Cotton</p>
      </div>

      <div style="text-align: center;">
        <p
          class="gold-text"
          style="
            margin: 0;
            font-family: 'Arial Black', Arial, sans-serif;
            font-size: clamp(1rem, 2vw, 1.25rem);
            font-weight: 900;
          "
        >00s</p>
        <p
          style="
            margin: 2px 0 0;
            font-family: Arial, sans-serif;
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #525252;
          "
        >Era Inspired</p>
      </div>

      <div style="text-align: center;">
        <p
          class="gold-text"
          style="
            margin: 0;
            font-family: 'Arial Black', Arial, sans-serif;
            font-size: clamp(1rem, 2vw, 1.25rem);
            font-weight: 900;
          "
        >Ltd.</p>
        <p
          style="
            margin: 2px 0 0;
            font-family: Arial, sans-serif;
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #525252;
          "
        >Drops Only</p>
      </div>

    </div>
  </div>

  <!-- Bottom fade overlay -->
  <div
    aria-hidden="true"
    style="
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 96px;
      background: linear-gradient(to bottom, transparent, #080808);
      pointer-events: none;
    "
  ></div>

</section>

<style>
  @media (min-width: 1024px) {
    .hero-side-line { display: block !important; }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "limit": 1,
  "settings": [],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
